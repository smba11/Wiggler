<Window x:Class="WigglerBySmba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WIGGLER by SMBA"
        Width="1040"
        Height="780"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <DropShadowEffect x:Key="ShellShadow"
                          BlurRadius="44"
                          ShadowDepth="0"
                          Opacity="0.34"
                          Color="#C0000000" />

        <LinearGradientBrush x:Key="HeroGlowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2E1BC7A5" Offset="0" />
            <GradientStop Color="#081BC7A5" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="BubbleButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBubbleButtonStyle" TargetType="Button" BasedOn="{StaticResource BubbleButtonStyle}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="StatusChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeChipBorderBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="18,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}" />
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <Path Grid.Column="1"
                                          Width="10"
                                          Height="6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource SubtleTextBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M 0 0 L 5 5 L 10 0" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Margin="0,8,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource SettingsPanelBrush}"
                                        BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Effect="{StaticResource ShellShadow}">
                                    <ScrollViewer Margin="6"
                                                  CanContentScroll="False"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="2"
                                Background="Transparent"
                                CornerRadius="12">
                            <ContentPresenter Margin="12,0"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeChipBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainColumn" Width="*" />
            <ColumnDefinition x:Name="SettingsSpacerColumn" Width="0" />
            <ColumnDefinition x:Name="SettingsColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Border x:Name="MainShell"
                Grid.Column="0"
                Padding="24"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                BorderThickness="1"
                CornerRadius="30"
                Effect="{StaticResource ShellShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="40"
                                Height="64"
                                Margin="0,0,16,0"
                                Background="Transparent">
                            <Canvas Width="40" Height="64">
                                <Path Stroke="#F4F6F8"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Data="M 10 26 C 15 16, 24 9, 32 10" />
                                <Path Stroke="#F4F6F8"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Data="M 7 38 C 13 21, 23 13, 35 15" />
                                <Path Stroke="#F4F6F8"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Data="M 7 42 L 21 22 L 24 35 L 33 35 L 15 56 L 18 42 Z" />
                            </Canvas>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="28"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding BrandTitle}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="14"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding BrandSubtitle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Border Style="{StaticResource StatusChipStyle}"
                                Margin="0,0,14,0">
                            <Grid MinWidth="92">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot"
                                         Width="10"
                                         Height="10"
                                         Margin="0,0,12,0"
                                         Fill="{Binding StatusDotBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding StatusLabel}" />
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource IconBubbleButtonStyle}"
                                Command="{Binding ToggleSettingsCommand}"
                                Content="&#xE713;"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="18" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Width="460"
                                Margin="0,-10,0,0">
                        <Border x:Name="ToggleGlow"
                                Width="282"
                                Height="124"
                                HorizontalAlignment="Center"
                                Background="{StaticResource HeroGlowBrush}"
                                CornerRadius="66"
                                Opacity="0.58"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ToggleGlowScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <BlurEffect Radius="28" />
                            </Border.Effect>
                        </Border>

                        <Button x:Name="ToggleButton"
                                Width="286"
                                Height="98"
                                Margin="0,-111,0,0"
                                Command="{Binding TogglePowerCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand">
                            <Border x:Name="ToggleTrack"
                                    Width="286"
                                    Height="98"
                                    Background="{Binding ToggleTrackBrush}"
                                    BorderBrush="{Binding ToggleTrackBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="49"
                                    SnapsToDevicePixels="True">
                                <Grid Margin="12">
                                    <TextBlock Margin="42,0,0,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="#F6FAFB"
                                               Panel.ZIndex="1"
                                               Text="{Binding ToggleStateWord}" />
                                    <Border x:Name="ToggleKnob"
                                            Width="74"
                                            Height="74"
                                            HorizontalAlignment="Right"
                                            Background="#F6F7F8"
                                            CornerRadius="37"
                                            SnapsToDevicePixels="True">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ToggleKnobTransform" X="0" />
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20"
                                                              ShadowDepth="2"
                                                              Opacity="0.22"
                                                              Color="#FF000000" />
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <TextBlock Margin="0,32,0,0"
                                   HorizontalAlignment="Center"
                                   MaxWidth="460"
                                   FontSize="36"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding HeroLabel}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   MaxWidth="420"
                                   FontSize="16"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding StatusDetail}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />

                        <Border Width="200"
                                Height="1"
                                Margin="0,30,0,20"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource ThemeChipBorderBrush}" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="&#xE115;" />
                            <TextBlock Margin="14,0,0,0"
                                       FontSize="15"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding PatternLabel}" />
                            <TextBlock Margin="6,0,0,0"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding LocalizedSelectedPattern}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons"
                               FontSize="18"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="&#xE7F4;" />
                    <TextBlock Margin="12,0,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               MaxWidth="700"
                               Text="{Binding TrayReadyBody}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="SettingsShell"
                Grid.Column="2"
                Padding="22"
                Background="{DynamicResource SettingsBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                BorderThickness="1"
                CornerRadius="30"
                Effect="{StaticResource ShellShadow}"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Text="{Binding SettingsHeaderTitle}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource IconBubbleButtonStyle}"
                            Width="52"
                            Height="52"
                            Command="{Binding ToggleSettingsCommand}"
                            Content="&#xE711;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,26,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="6,0,0,12"
                                   FontSize="13"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding BehaviorSectionTitle}" />
                        <Border Padding="14"
                                Background="{DynamicResource SettingsPanelBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="18"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="&#xE7AD;" />
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding LaunchInLabel}" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding LaunchModeItems}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedLaunchMode}" />
                                </Grid>

                                <Border Height="1"
                                        Margin="0,2,0,12"
                                        Background="{DynamicResource ThemeChipBorderBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="18"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="&#xE8AB;" />
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding CloseBehaviorLabel}" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding CloseBehaviorItems}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedCloseBehavior}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="6,24,0,12"
                                   FontSize="13"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding MovementSectionTitle}" />
                        <Border Padding="14"
                                Background="{DynamicResource SettingsPanelBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="18"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="&#xE115;" />
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding PatternLabel}" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding PatternItems}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedPattern}" />
                                </Grid>

                                <Border Height="1" Margin="0,2,0,12" Background="{DynamicResource ThemeChipBorderBrush}" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="74" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="18"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="&#xE9E9;" />
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding SpeedLabel}" />
                                    <Slider Grid.Column="2"
                                            Minimum="0.5"
                                            Maximum="3"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding Speed}" />
                                    <TextBlock Grid.Column="3"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding SpeedDisplay}" />
                                </Grid>

                                <Border Height="1" Margin="0,0,0,12" Background="{DynamicResource ThemeChipBorderBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="74" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="18"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="&#xE740;" />
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding SizeLabel}" />
                                    <Slider Grid.Column="2"
                                            Minimum="40"
                                            Maximum="180"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding Size}" />
                                    <TextBlock Grid.Column="3"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding SizeDisplay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="6,24,0,12"
                                   FontSize="13"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding IdleDelayLabel}" />
                        <Border Padding="14"
                                Background="{DynamicResource SettingsPanelBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="74" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="18"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="&#xE823;" />
                                <TextBlock Grid.Column="1"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding IdleDelayLabel}" />
                                <Slider Grid.Column="2"
                                        Minimum="5"
                                        Maximum="60"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding IdleDelaySeconds}" />
                                <TextBlock Grid.Column="3"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding IdleDelayDisplay}" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="6,24,0,12"
                                   FontSize="13"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding AppearanceSectionTitle}" />
                        <Border Padding="14"
                                Background="{DynamicResource SettingsPanelBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="18"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="&#xE790;" />
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding ThemeLabel}" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding ThemeModeItems}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedThemeMode}" />
                                </Grid>

                                <Border Height="1"
                                        Margin="0,2,0,12"
                                        Background="{DynamicResource ThemeChipBorderBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="18"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="&#xE774;" />
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding LanguageLabel}" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding LanguageItems}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedLanguageCode}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="6,24,0,12"
                                   FontSize="13"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding HelpSectionTitle}" />
                        <Border Padding="14"
                                Background="{DynamicResource SettingsPanelBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="18"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="&#xE897;" />
                                <TextBlock Grid.Column="1"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding ReplayTutorialLabel}" />
                                <Button Grid.Column="2"
                                        Width="44"
                                        Height="44"
                                        Style="{StaticResource BubbleButtonStyle}"
                                        Command="{Binding ReplayTutorialCommand}"
                                        Content="&#xE72A;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="14" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="StatusDot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="1"
                                     To="0.55"
                                     Duration="0:0:1.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
