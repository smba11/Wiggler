<Application x:Class="WigglerBySmba.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F1EC" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFF9F7F3" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FFF2F6F4" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF156F67" />
        <SolidColorBrush x:Key="AccentMutedBrush" Color="#1A156F67" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF18212B" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF677381" />
        <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#FFF7F5F0" />
        <SolidColorBrush x:Key="SettingsPanelBrush" Color="#FFFEFCF8" />
        <SolidColorBrush x:Key="ThemeChipBrush" Color="#FFE9F2EF" />
        <SolidColorBrush x:Key="ThemeChipBorderBrush" Color="#FFD7E0DC" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Application.Resources>
</Application>
