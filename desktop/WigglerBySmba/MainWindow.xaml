<Window x:Class="WigglerBySmba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WIGGLER by SMBA"
        Width="980"
        Height="690"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryToggleButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
            <Setter Property="Background" Value="{Binding ToggleButtonBrush}" />
            <Setter Property="BorderBrush" Value="{Binding ToggleButtonBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="24"
                                Padding="26,18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="48" />
            <Setter Property="MaxDropDownHeight" Value="240" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeChipBorderBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="16,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}" />
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <Path Grid.Column="1"
                                          Width="10"
                                          Height="6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource SubtleTextBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M 0 0 L 5 5 L 10 0" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Margin="0,8,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <ScrollViewer Margin="6"
                                                  CanContentScroll="False"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="2"
                                Background="Transparent"
                                CornerRadius="12">
                            <ContentPresenter Margin="12,0"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeChipBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{Binding BrandTitle}" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="{Binding BrandSubtitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Padding="14,8"
                        Margin="0,0,12,0"
                        Background="{Binding StatusChipBrush}"
                        CornerRadius="999">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12"
                                   Foreground="{Binding StatusChipTextBrush}"
                                   Text="{Binding StatusTitle}" />
                        <TextBlock Margin="8,0,0,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusChipTextBrush}"
                                   Text="{Binding StatusLabel}" />
                    </StackPanel>
                </Border>

                <Button Width="46"
                        Height="46"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ToggleSettingsCommand}"
                        Content="&#xE713;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Border HorizontalAlignment="Center"
                    MaxWidth="760"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource HeroOutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="30"
                    Padding="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding HeroEyebrow}" />
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="42"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding HeroLabel}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="15"
                                   LineHeight="22"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding StatusDetail}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Row="1"
                            Width="260"
                            Height="78"
                            Margin="0,28,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding TogglePowerCommand}"
                            Style="{StaticResource PrimaryToggleButtonStyle}">
                        <TextBlock Text="{Binding ToggleButtonLabel}" />
                    </Button>

                    <UniformGrid Grid.Row="2"
                                 Margin="0,28,0,0"
                                 Columns="3">
                        <Border Margin="0,0,10,0"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding PatternCardTitle}" />
                                <TextBlock Margin="0,10,0,0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding LocalizedSelectedPattern}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="5,0"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding IdleDelayCardTitle}" />
                                <TextBlock Margin="0,10,0,0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding IdleDelayDisplay}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="10,0,0,0"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding TakeoverTitle}" />
                                <TextBlock Margin="0,10,0,0"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding TakeoverValue}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="3" Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock FontSize="14"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding PatternSummary}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Width="150"
                                    Height="44"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ToggleSettingsCommand}"
                                    Content="{Binding SettingsButtonLabel}" />
                            <Button Width="150"
                                    Height="44"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ReplayTutorialCommand}"
                                    Content="{Binding ReplayTutorialLabel}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Width="360"
                    MaxHeight="560"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="5"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource SettingsBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="26"
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding SettingsHeaderTitle}" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="13"
                                       LineHeight="20"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding SettingsSubtitle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="36"
                                Height="36"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleSettingsCommand}"
                                Content="&#xE711;"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,18,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Padding="18"
                                    Background="{DynamicResource SettingsPanelBrush}"
                                    BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <StackPanel>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding BehaviorSectionTitle}" />
                                    <TextBlock Margin="0,14,0,6"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding LaunchInLabel}" />
                                    <ComboBox ItemsSource="{Binding LaunchModeItems}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedLaunchMode}" />
                                    <TextBlock Margin="0,14,0,6"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding CloseBehaviorLabel}" />
                                    <ComboBox ItemsSource="{Binding CloseBehaviorItems}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedCloseBehavior}" />
                                    <TextBlock Margin="0,14,0,6"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding ThemeLabel}" />
                                    <ComboBox ItemsSource="{Binding ThemeModeItems}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedThemeMode}" />
                                    <TextBlock Margin="0,14,0,6"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding LanguageLabel}" />
                                    <ComboBox ItemsSource="{Binding LanguageItems}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedLanguageCode}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0"
                                    Padding="18"
                                    Background="{DynamicResource SettingsPanelBrush}"
                                    BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <StackPanel>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding IdleDelayLabel}" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="13"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding IdleDelayDisplay}" />
                                    <Slider Margin="0,14,0,0"
                                            Minimum="5"
                                            Maximum="60"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding IdleDelaySeconds}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0"
                                    Padding="18"
                                    Background="{DynamicResource SettingsPanelBrush}"
                                    BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <StackPanel>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding MovementSectionTitle}" />
                                    <TextBlock Margin="0,14,0,6"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding PatternLabel}" />
                                    <ComboBox ItemsSource="{Binding PatternItems}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedPattern}" />
                                    <TextBlock Margin="0,14,0,6"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding SpeedLabel}" />
                                    <Slider Minimum="0.5"
                                            Maximum="3"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding Speed}" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding SpeedDisplay}" />
                                    <TextBlock Margin="0,14,0,6"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding SizeLabel}" />
                                    <Slider Minimum="40"
                                            Maximum="180"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding Size}" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding SizeDisplay}" />
                                    <TextBlock Margin="0,14,0,6"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding ColorVibeLabel}" />
                                    <ComboBox ItemsSource="{Binding ThemeVibeItems}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedThemeVibe}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0"
                                    Padding="18"
                                    Background="{DynamicResource SettingsPanelBrush}"
                                    BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <StackPanel>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding HelpSectionTitle}" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="13"
                                               LineHeight="20"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding TrayReadyBody}"
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,16,0,0"
                                            Height="44"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ReplayTutorialCommand}"
                                            Content="{Binding ReplayTutorialLabel}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
