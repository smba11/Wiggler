<Window x:Class="WigglerBySmba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WIGGLER by SMBA"
        Width="1060"
        Height="900"
        MinWidth="900"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <DropShadowEffect x:Key="ShellShadow"
                          BlurRadius="42"
                          ShadowDepth="0"
                          Opacity="0.28"
                          Color="#99000000" />

        <Style x:Key="UtilityButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource UtilityButtonStyle}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PrimaryToggleButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
            <Setter Property="Background" Value="{Binding ToggleButtonBrush}" />
            <Setter Property="BorderBrush" Value="{Binding ToggleButtonBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="38"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="78"
                                        Height="78"
                                        Background="#22000000"
                                        CornerRadius="39">
                                    <Border Width="58"
                                            Height="58"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#30FFFFFF"
                                            CornerRadius="29">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="30"
                                                   Foreground="{DynamicResource ButtonTextBrush}"
                                                   Text="&#xE768;" />
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="22,0,22,0"
                                            VerticalAlignment="Center">
                                    <ContentPresenter HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="13"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource ButtonTextBrush}"
                                               Opacity="0.84"
                                               Text="{Binding PatternSummary}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.94" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeChipBorderBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="23">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="18,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}" />
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <Path Grid.Column="1"
                                          Width="10"
                                          Height="6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource SubtleTextBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M 0 0 L 5 5 L 10 0" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Margin="0,8,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource SettingsPanelBrush}"
                                        BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="23"
                                        Effect="{StaticResource ShellShadow}">
                                    <ScrollViewer Margin="6"
                                                  CanContentScroll="False"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="2"
                                Background="Transparent"
                                CornerRadius="18">
                            <ContentPresenter Margin="12,0"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeChipBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainColumn" Width="*" />
            <ColumnDefinition x:Name="SettingsSpacerColumn" Width="0" />
            <ColumnDefinition x:Name="SettingsColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Border x:Name="MainShell"
                Grid.Column="0"
                Padding="28"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                BorderThickness="1"
                CornerRadius="30"
                Effect="{StaticResource ShellShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="42"
                                Height="42"
                                Margin="0,0,14,0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Viewbox Margin="9">
                                <Canvas Width="26" Height="26">
                                    <Path Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="1.9"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Data="M 4 15 L 14 2 L 16 11 L 23 11 L 9 25 L 10.5 16 Z" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="18"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding BrandTitle}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding BrandSubtitle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Border Padding="18,10"
                                Margin="0,0,12,0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="22">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot"
                                         Width="10"
                                         Height="10"
                                         Margin="0,0,10,0"
                                         Fill="{Binding StatusDotBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding StatusLabel}" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleSettingsCommand}"
                                Content="&#xE713;"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="16" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,28,0,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,18,0,0">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding HeroEyebrow}" />
                        <TextBlock Margin="0,18,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="52"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding HeroLabel}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="15"
                                   LineHeight="24"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding StatusDetail}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,38,0,0"
                                HorizontalAlignment="Center">
                        <Button Width="360"
                                Height="102"
                                HorizontalAlignment="Center"
                                Command="{Binding TogglePowerCommand}"
                                Style="{StaticResource PrimaryToggleButtonStyle}">
                            <TextBlock Text="{Binding ToggleButtonLabel}" />
                        </Button>
                        <TextBlock Margin="0,16,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding BehaviorSummary}" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,44,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="24"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44"
                                        Height="44"
                                        Background="{DynamicResource SurfaceMutedBrush}"
                                        BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="18"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="&#xE115;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock FontSize="13"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding PatternCardTitle}" />
                                    <TextBlock Margin="0,14,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding LocalizedSelectedPattern}" />
                                    <TextBlock Margin="0,12,0,0"
                                               FontSize="14"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding PatternSummary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="16"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="&#xE72A;" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="24"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44"
                                        Height="44"
                                        Background="{DynamicResource SurfaceMutedBrush}"
                                        BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="18"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="&#xE823;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock FontSize="13"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding IdleDelayCardTitle}" />
                                    <TextBlock Margin="0,14,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding IdleDelayDisplay}" />
                                    <TextBlock Margin="0,12,0,0"
                                               FontSize="14"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding StatusDetail}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="16"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="&#xE72A;" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            Margin="0,18,0,0"
                            Padding="24"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44"
                                    Height="44"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="18"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="&#xE73E;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding TakeoverTitle}" />
                                <TextBlock Margin="0,12,0,0"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding TakeoverValue}" />
                                <TextBlock Margin="0,12,0,0"
                                           FontSize="14"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding TrayReadyBody}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="&#xE72A;" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Padding="18"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48"
                                    Height="48"
                                    Margin="0,0,14,0"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="15">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="&#xE7F4;" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding TrayReadyTitle}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="14"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding TrayReadyBody}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button MinWidth="146"
                                    Height="46"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource UtilityButtonStyle}"
                                    Command="{Binding ReplayTutorialCommand}"
                                    Content="{Binding ReplayTutorialLabel}" />
                            <Button MinWidth="160"
                                    Height="46"
                                    Style="{StaticResource UtilityButtonStyle}"
                                    Command="{Binding ToggleSettingsCommand}"
                                    Content="{Binding SettingsButtonLabel}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="SettingsShell"
                Grid.Column="2"
                Padding="24"
                Background="{DynamicResource SettingsBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                BorderThickness="1"
                CornerRadius="30"
                Effect="{StaticResource ShellShadow}"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding SettingsHeaderTitle}" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="14"
                                   LineHeight="22"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding SettingsSubtitle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleSettingsCommand}"
                            Content="&#xE711;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,22,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Padding="18"
                                Background="{DynamicResource SettingsPanelBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="22">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Text="&#xE713;" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Text="{Binding BehaviorSectionTitle}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                   Text="{Binding TrayReadyTitle}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Margin="0,18,0,6"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding LaunchInLabel}" />
                                <ComboBox ItemsSource="{Binding LaunchModeItems}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedLaunchMode}" />
                                <TextBlock Margin="0,14,0,6"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding CloseBehaviorLabel}" />
                                <ComboBox ItemsSource="{Binding CloseBehaviorItems}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedCloseBehavior}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0"
                                Padding="18"
                                Background="{DynamicResource SettingsPanelBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="22">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="&#xE115;" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Text="{Binding MovementSectionTitle}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                   Text="{Binding PatternSummary}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Margin="0,18,0,6"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding PatternLabel}" />
                                <ComboBox ItemsSource="{Binding PatternItems}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedPattern}" />
                                <TextBlock Margin="0,14,0,6"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding SpeedLabel}" />
                                <Border Height="42"
                                        Padding="14,0"
                                        Background="{DynamicResource SurfaceMutedBrush}"
                                        BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="15">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding SpeedDisplay}" />
                                </Border>
                                <Slider Minimum="0.5"
                                        Maximum="3"
                                        TickFrequency="0.1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding Speed}" />
                                <TextBlock Margin="0,12,0,6"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding SizeLabel}" />
                                <Border Height="42"
                                        Padding="14,0"
                                        Background="{DynamicResource SurfaceMutedBrush}"
                                        BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="15">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding SizeDisplay}" />
                                </Border>
                                <Slider Minimum="40"
                                        Maximum="180"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding Size}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0"
                                Padding="18"
                                Background="{DynamicResource SettingsPanelBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="22">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Text="&#xE823;" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Text="{Binding IdleDelayLabel}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                   Text="{Binding BehaviorSummary}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Margin="0,18,0,0"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding IdleDelayDisplay}" />
                                <Slider Minimum="5"
                                        Maximum="60"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding IdleDelaySeconds}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="5 sec" />
                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="60 sec" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0"
                                Padding="18"
                                Background="{DynamicResource SettingsPanelBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="22">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Text="&#xE790;" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Text="{Binding AppearanceSectionTitle}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                   Text="{Binding LanguageLabel}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Margin="0,18,0,6"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding ThemeLabel}" />
                                <ComboBox ItemsSource="{Binding ThemeModeItems}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedThemeMode}" />
                                <TextBlock Margin="0,14,0,6"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding ColorVibeLabel}" />
                                <ComboBox ItemsSource="{Binding ThemeVibeItems}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedThemeVibe}" />
                                <TextBlock Margin="0,14,0,6"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="{Binding LanguageLabel}" />
                                <ComboBox ItemsSource="{Binding LanguageItems}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedLanguageCode}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0"
                                Padding="18"
                                Background="{DynamicResource SettingsPanelBrush}"
                                BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="22">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource ThemeChipBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Text="&#xE897;" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Text="{Binding HelpSectionTitle}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                   Text="{Binding TrayReadyBody}" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Margin="0,18,0,0"
                                        Height="46"
                                        Style="{StaticResource UtilityButtonStyle}"
                                        Command="{Binding ReplayTutorialCommand}"
                                        Content="{Binding ReplayTutorialLabel}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="StatusDot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="1"
                                     To="0.55"
                                     Duration="0:0:1.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
